{
  "name": "it-tools",
  "version": "1.0.0",
  "description": "A set of useful IT tools in a MVC-architecture.",
  "scripts": {
    "start": "tailwindcss -i src/views/input.css -o public/css/tailwind.css -m && tsx src/index.ts",
    "dev": "concurrently \"tsx --watch src/index.ts\" \"tailwindcss -i src/views/input.css -o public/css/tailwind.css -m -w\"",
    "format": "prettier --w ./src"
  },
  "type": "module",
  "keywords": [],
  "author": "Nguyet Anh <frillyanh@gmail.com>",
  "contributors": [
    {
      "name": "Nguyen Phuc An",
      "url": "https://github.com/nguyennguyennam"
    }
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.41.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "memorystore": "^1.6.7",
    "pg": "^8.16.3",
    "zod": "^3.25.76",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.13",
    "@types/pg": "^8.15.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.30.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-ejs": "^1.0.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
